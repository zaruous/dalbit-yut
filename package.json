{
  "name": "dalbit-yut",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Typed React Yutnori with hand-controlled pieces and cinematic Korean theme",
  "scripts": {
    "dev": "vite --host",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host",
    "test": "tsc -p tsconfig.test.json && node scripts/mark-commonjs.cjs && node test-engine.cjs",
    "build:static": "tsc -p tsconfig.static.json",
    "build:preview": "node scripts/build-preview.cjs",
    "test:laya": "npm test && node --test test-laya.cjs test-laya-rollout.cjs",
    "laya:benchmark": "npm test && node scripts/benchmark-laya.cjs",
    "laya:server": "node scripts/laya-server.cjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^6.3.0"
  }
}
